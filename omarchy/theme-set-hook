#!/bin/bash
# chroma theme-set hook — run by omarchy at the end of every theme switch.
# Quiet and non-fatal: never abort the theme switch.

set -uo pipefail

PLUGIN="${CHROMA_PLUGIN_DIR:-$HOME/.config/omarchy/plugins/io.github.alxwolfenstein97.chroma}"
APPLY="$PLUGIN/bin/chroma-apply"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/chroma"
ERR="$STATE/last-hook-error"
RUN="$STATE/last-run"

mkdir -p "$STATE" 2>/dev/null || true
rm -f "$ERR" 2>/dev/null || true

[[ -f $APPLY ]] || exit 0

# python3 avoids a lost +x bit silently skipping theming after plugin update.
if command -v python3 >/dev/null 2>&1; then
  out=$(python3 "$APPLY" --no-restart 2>&1)
else
  [[ -x $APPLY ]] || exit 0
  out=$("$APPLY" --no-restart 2>&1)
fi
status=$?

printf '%s\n' "$out" >"$RUN" 2>/dev/null || true

if ((status != 0)); then
  printf '%s\n' "$out" >"$ERR" 2>/dev/null || true
  exit 0
fi

# A dark switch pins open libhandy windows to stock Adwaita. Surface the one
# line the user can act on; the full run stays in last-run.
if [[ $out == *"relaunch "* ]]; then
  printf 'chroma: relaunch %s\n' "${out##*relaunch }" >&2
fi
exit 0
