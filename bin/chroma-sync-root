#!/usr/bin/python3
"""chroma-sync-root — copy staged GTK/Qt theme files into root's config.

Must run as root (via sudo -n from chroma-apply, or manually with sudo/pkexec).
Only copies paths listed in the stage manifest; never follows unexpected paths.

Generated GTK3 wrapper themes land in /root/.local/share/themes so root GTK
apps can resolve the theme name written into /root/.config/gtk-3.0/settings.ini.
"""

from __future__ import annotations

import json
import os
import pwd
import re
import shutil
import sys
import tempfile
from pathlib import Path

ROOT_CONFIG = Path("/root/.config")
ROOT_DATA = Path("/root/.local/share")
CONFIG_PREFIXES = (
    "gtk-3.0/",
    "gtk-4.0/",
    "qt5ct/",
    "qt6ct/",
)
DATA_PREFIXES = ("themes/",)
WRAPPER_DIR_RE = re.compile(r"-chroma-[ab]$")


def resolve_stage() -> Path:
    env = os.environ.get("CHROMA_ROOT_STAGE")
    if env:
        return Path(env)

    # sudo/pkexec reset HOME to /root — recover the invoking user's stage.
    user = os.environ.get("SUDO_USER")
    if not user and os.environ.get("PKEXEC_UID", "").isdigit():
        try:
            user = pwd.getpwuid(int(os.environ["PKEXEC_UID"])).pw_name
        except KeyError:
            user = None
    if user:
        try:
            home = Path(pwd.getpwnam(user).pw_dir)
            return home / ".local/share/chroma/root-sync"
        except KeyError:
            pass

    homes = sorted(Path("/home").glob("*/.local/share/chroma/root-sync/manifest.json"))
    if homes:
        return homes[0].parent

    return Path("/nonexistent")


def atomic_copy(src: Path, dest: Path):
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(dest.parent), prefix=f".{dest.name}.")
    os.close(fd)
    tmp_path = Path(tmp)
    try:
        shutil.copy2(src, tmp_path)
        os.chmod(tmp_path, 0o644)
        os.replace(tmp_path, dest)
    except BaseException:
        try:
            tmp_path.unlink()
        except OSError:
            pass
        raise


def main() -> int:
    if os.geteuid() != 0:
        print("chroma-sync-root: must run as root (sudo -n ...)", file=sys.stderr)
        return 1

    stage = resolve_stage()
    manifest_path = stage / "manifest.json"
    if not manifest_path.is_file():
        print(f"chroma-sync-root: no stage at {stage}", file=sys.stderr)
        return 2

    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        print(f"chroma-sync-root: bad manifest: {e}", file=sys.stderr)
        return 2

    copied = []
    staged_themes = set()
    for rel in manifest.get("files") or []:
        rel = str(rel).lstrip("/")
        if ".." in rel.split("/"):
            print(f"chroma-sync-root: refusing {rel}", file=sys.stderr)
            continue
        if rel.startswith(CONFIG_PREFIXES):
            base = ROOT_CONFIG
        elif rel.startswith(DATA_PREFIXES):
            base = ROOT_DATA
            parts = rel.split("/")
            if len(parts) > 1:
                staged_themes.add(parts[1])
        else:
            print(f"chroma-sync-root: refusing {rel}", file=sys.stderr)
            continue
        src = stage / rel
        if not src.is_file():
            continue
        dest = base / rel
        atomic_copy(src, dest)
        copied.append(rel)

    # Drop wrapper themes from previous palettes; only inside a real directory
    # (never through a symlink to the user's themes tree).
    themes_root = ROOT_DATA / "themes"
    if themes_root.is_dir() and not themes_root.is_symlink():
        for entry in themes_root.iterdir():
            if not entry.is_dir() or not WRAPPER_DIR_RE.search(entry.name):
                continue
            if entry.name not in staged_themes:
                shutil.rmtree(entry, ignore_errors=True)

    print(f"chroma-sync-root: synced {len(copied)} files into {ROOT_CONFIG} and {ROOT_DATA}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
