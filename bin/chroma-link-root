#!/usr/bin/python3
"""chroma-link-root — one-time: point /root/.config GTK/Qt dirs at the user's.

After this, every Chroma theme apply to ~/.config is what root sees too
(pkexec BleachBit, sudo bleachbit, etc.) with no per-switch elevation.

Must run as root. Invoking user is taken from SUDO_USER / PKEXEC_UID.

Important: never leave user-owned paths (under $HOME) owned by root. A prior
bug mkdir'd ~/.config/gtk-* as root when --with-root ran before the first
apply on a fresh machine — then chroma-apply could not write CSS.
"""

from __future__ import annotations

import os
import pwd
import sys
from pathlib import Path

TARGETS = ("gtk-3.0", "gtk-4.0", "qt6ct", "qt5ct")


def invoking_user() -> tuple[str, Path, int, int]:
    user = os.environ.get("SUDO_USER")
    if not user and os.environ.get("PKEXEC_UID", "").isdigit():
        try:
            user = pwd.getpwuid(int(os.environ["PKEXEC_UID"])).pw_name
        except KeyError:
            user = None
    if not user:
        print("chroma-link-root: cannot tell who invoked us", file=sys.stderr)
        sys.exit(1)
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        print(f"chroma-link-root: unknown user {user}", file=sys.stderr)
        sys.exit(1)
    return user, Path(pw.pw_dir), pw.pw_uid, pw.pw_gid


def ensure_user_dir(path: Path, uid: int, gid: int) -> None:
    """Create path if needed and force ownership back to the invoking user."""
    path.mkdir(parents=True, exist_ok=True)
    try:
        st = path.stat()
        if st.st_uid != uid or st.st_gid != gid:
            os.chown(path, uid, gid)
    except OSError as e:
        print(f"chroma-link-root: chown {path}: {e}", file=sys.stderr)
        raise


def main() -> int:
    if os.geteuid() != 0:
        print("chroma-link-root: must run as root", file=sys.stderr)
        return 1

    _user, home, uid, gid = invoking_user()
    src_base = home / ".config"
    root_base = Path("/root/.config")
    # .config itself must stay user-owned if we create it.
    ensure_user_dir(src_base, uid, gid)
    root_base.mkdir(parents=True, exist_ok=True)

    linked = []
    for name in TARGETS:
        src = src_base / name
        dest = root_base / name
        ensure_user_dir(src, uid, gid)

        if dest.is_symlink() and dest.resolve() == src.resolve():
            linked.append(f"{name}=already")
            continue

        if dest.exists() and not dest.is_symlink():
            backup = dest.with_name(dest.name + ".chroma-prelink")
            if not backup.exists():
                dest.rename(backup)
            else:
                import shutil

                shutil.rmtree(dest)

        if dest.is_symlink() or dest.exists():
            dest.unlink()

        dest.symlink_to(src)
        linked.append(f"{name}=linked")

    # Marker the user session can see without reading /root — must be
    # user-writable so uninstall/wipe can clear it without elevation.
    state = home / ".local/state/omarchy/chroma"
    ensure_user_dir(home / ".local/state", uid, gid)
    ensure_user_dir(home / ".local/state/omarchy", uid, gid)
    ensure_user_dir(state, uid, gid)
    marker = state / "root-linked"
    marker.write_text(
        "symlinks /root/.config/{gtk-3.0,gtk-4.0,qt6ct,qt5ct} → "
        f"{src_base}/…\n",
        encoding="utf-8",
    )
    os.chown(marker, uid, gid)
    # Clear the old "needs elevation every apply" flag.
    stale = state / "root-needs-elevation"
    if stale.exists():
        try:
            stale.unlink()
        except OSError:
            pass

    print("chroma-link-root: " + ", ".join(linked))
    return 0


if __name__ == "__main__":
    sys.exit(main())
