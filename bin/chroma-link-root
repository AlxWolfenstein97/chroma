#!/usr/bin/python3
"""chroma-link-root — one-time: point /root config dirs at the user's.

After this, every Chroma theme apply to ~/.config is what root sees too
(pkexec BleachBit, sudo bleachbit, etc.) with no per-switch elevation.

Also links /root/.local/share/themes → the user's themes directory, because
generated GTK3 wrapper themes live there and root GTK apps resolve theme names
through $XDG_DATA_HOME/themes.

Must run as root. Invoking user is taken from SUDO_USER / PKEXEC_UID.

Important: never leave user-owned paths (under $HOME) owned by root. A prior
bug mkdir'd ~/.config/gtk-* as root when --with-root ran before the first
apply on a fresh machine — then chroma-apply could not write CSS.
"""

from __future__ import annotations

import os
import pwd
import sys
import time
from pathlib import Path

TARGETS = ("gtk-3.0", "gtk-4.0", "qt6ct", "qt5ct")


def invoking_user() -> tuple[str, Path, int, int]:
    user = os.environ.get("SUDO_USER")
    if not user and os.environ.get("PKEXEC_UID", "").isdigit():
        try:
            user = pwd.getpwuid(int(os.environ["PKEXEC_UID"])).pw_name
        except KeyError:
            user = None
    if not user:
        print("chroma-link-root: cannot tell who invoked us", file=sys.stderr)
        sys.exit(1)
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        print(f"chroma-link-root: unknown user {user}", file=sys.stderr)
        sys.exit(1)
    return user, Path(pw.pw_dir), pw.pw_uid, pw.pw_gid


def ensure_user_dir(path: Path, uid: int, gid: int) -> None:
    """Create path if needed and force ownership back to the invoking user."""
    path.mkdir(parents=True, exist_ok=True)
    try:
        st = path.stat()
        if st.st_uid != uid or st.st_gid != gid:
            os.chown(path, uid, gid)
    except OSError as e:
        print(f"chroma-link-root: chown {path}: {e}", file=sys.stderr)
        raise


def main() -> int:
    if os.geteuid() != 0:
        print("chroma-link-root: must run as root", file=sys.stderr)
        return 1

    _user, home, uid, gid = invoking_user()
    src_base = home / ".config"
    root_base = Path("/root/.config")
    # .config itself must stay user-owned if we create it.
    ensure_user_dir(src_base, uid, gid)
    root_base.mkdir(parents=True, exist_ok=True)

    linked = []
    for name in TARGETS:
        src = src_base / name
        dest = root_base / name
        ensure_user_dir(src, uid, gid)

        if dest.is_symlink() and dest.resolve() == src.resolve():
            linked.append(f"{name}=already")
            continue

        if dest.exists() and not dest.is_symlink():
            # Never rmtree root GTK/Qt dirs — a re-run can wipe configs written
            # after the first link. Prefer a unique backup when the canonical
            # .chroma-prelink slot is already taken.
            backup = dest.with_name(dest.name + ".chroma-prelink")
            if backup.exists():
                stamp = time.strftime("%Y%m%d%H%M%S")
                backup = dest.with_name(f"{dest.name}.chroma-prelink.{stamp}")
            dest.rename(backup)
            print(
                f"chroma-link-root: preserved {dest} → {backup}",
                file=sys.stderr,
            )

        if dest.is_symlink() or dest.exists():
            dest.unlink()

        dest.symlink_to(src)
        linked.append(f"{name}=linked")

    # Generated wrapper themes live under the user's data dir.
    themes_src = home / ".local/share/themes"
    themes_dest = Path("/root/.local/share/themes")
    ensure_user_dir(home / ".local", uid, gid)
    ensure_user_dir(home / ".local/share", uid, gid)
    ensure_user_dir(themes_src, uid, gid)
    themes_dest.parent.mkdir(parents=True, exist_ok=True)
    if themes_dest.is_symlink() and themes_dest.resolve() == themes_src.resolve():
        linked.append("themes=already")
    else:
        if themes_dest.exists() and not themes_dest.is_symlink():
            backup = themes_dest.with_name(themes_dest.name + ".chroma-prelink")
            if backup.exists():
                stamp = time.strftime("%Y%m%d%H%M%S")
                backup = themes_dest.with_name(
                    f"{themes_dest.name}.chroma-prelink.{stamp}"
                )
            themes_dest.rename(backup)
            print(
                f"chroma-link-root: preserved {themes_dest} → {backup}",
                file=sys.stderr,
            )
        if themes_dest.is_symlink() or themes_dest.exists():
            themes_dest.unlink()
        themes_dest.symlink_to(themes_src)
        linked.append("themes=linked")

    # Marker the user session can see without reading /root — must be
    # user-writable so uninstall/wipe can clear it without elevation.
    state = home / ".local/state/omarchy/chroma"
    ensure_user_dir(home / ".local/state", uid, gid)
    ensure_user_dir(home / ".local/state/omarchy", uid, gid)
    ensure_user_dir(state, uid, gid)
    marker = state / "root-linked"
    marker.write_text(
        "symlinks /root/.config/{gtk-3.0,gtk-4.0,qt6ct,qt5ct} and "
        f"/root/.local/share/themes → {home}/…\n",
        encoding="utf-8",
    )
    os.chown(marker, uid, gid)
    # Clear the old "needs elevation every apply" flag.
    stale = state / "root-needs-elevation"
    if stale.exists():
        try:
            stale.unlink()
        except OSError:
            pass

    print("chroma-link-root: " + ", ".join(linked))
    return 0


if __name__ == "__main__":
    sys.exit(main())
