#!/usr/bin/python3
"""chroma-apply — full GTK3/GTK4 + Qt theming from the active Omarchy theme.

Writes:
  ~/.config/gtk-4.0/gtk.css          libadwaita @define-color palette
  ~/.config/gtk-3.0/gtk.css          classic named colors (+ dialog polish)
  ~/.config/gtk-{3,4}.0/settings.ini theme / prefer-dark / font
  ~/.config/qt6ct/colors/omarchy.conf + qt6ct.conf   (when qt6ct is present)
  ~/.config/qt5ct/...                                (when qt5ct is present)
  ~/.local/share/chroma/root-sync/                   staging for root apps
  ~/.local/state/omarchy/chroma/state.json

Also sets GNOME color-scheme + gtk-theme (preferring adw-gtk3 when installed),
pushes QT_QPA_PLATFORMTHEME into the user systemd/dbus environment when Qt CT
is available, and optionally syncs the staged files into /root/.config so
pkexec'd GUIs (BleachBit-as-root) and similar pick up the same palette.

Exit: 0 applied/reverted; 3 nothing applied (bad theme input).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

HOME = Path.home()


def _env_path(name: str, default: Path) -> Path:
    v = os.environ.get(name)
    return Path(v) if v else default


def _state_default() -> Path:
    base = os.environ.get("XDG_STATE_HOME")
    return (Path(base) if base else HOME / ".local/state") / "omarchy/chroma"


THEME_DIR = _env_path("CHROMA_THEME_DIR", HOME / ".local/state/omarchy/current/theme")
GTK4_CSS = _env_path("CHROMA_GTK4_CSS", HOME / ".config/gtk-4.0/gtk.css")
GTK3_CSS = _env_path("CHROMA_GTK3_CSS", HOME / ".config/gtk-3.0/gtk.css")
GTK4_INI = _env_path("CHROMA_GTK4_INI", HOME / ".config/gtk-4.0/settings.ini")
GTK3_INI = _env_path("CHROMA_GTK3_INI", HOME / ".config/gtk-3.0/settings.ini")
QT6_DIR = _env_path("CHROMA_QT6_DIR", HOME / ".config/qt6ct")
QT5_DIR = _env_path("CHROMA_QT5_DIR", HOME / ".config/qt5ct")
STATE_DIR = _env_path("CHROMA_STATE_DIR", _state_default())
ROOT_STAGE = _env_path(
    "CHROMA_ROOT_STAGE",
    Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "chroma/root-sync",
)
STATE_FILE = STATE_DIR / "state.json"
NO_GSETTINGS = os.environ.get("CHROMA_NO_GSETTINGS") == "1"
NO_ROOT = os.environ.get("CHROMA_NO_ROOT") == "1"
NO_QT_ENV = os.environ.get("CHROMA_NO_QT_ENV") == "1"

BEGIN = "/* >>> chroma:managed >>> generated from the active Omarchy theme; edits inside this block are overwritten */"
END = "/* <<< chroma:managed <<< */"

# Seed list — also auto-discovers --gapplication-service processes.
RESTART_SEED = [
    "nautilus", "geary", "gnome-calendar", "gnome-text-editor",
    "loupe", "evince", "snapshot", "gnome-characters", "baobab",
    "gnome-font-viewer", "eog", "file-roller",
]

HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
ENC = {"encoding": "utf-8", "errors": "surrogateescape"}


def read_file(path: Path) -> str:
    return path.read_text(**ENC)


def atomic_write(path: Path, text: str, enc=None, mode: int = 0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    kw = ENC if enc is None else enc
    fd, tmp = tempfile.mkstemp(
        dir=str(path.parent), prefix=f".{path.name}.", suffix=".chroma-tmp"
    )
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", **kw) as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def parse_hex(value):
    if isinstance(value, str) and HEX_RE.match(value.strip()):
        return value.strip().lower()
    return None


def luma(hex_color: str) -> float:
    r, g, b = (int(hex_color[i : i + 2], 16) for i in (1, 3, 5))
    return 0.299 * r + 0.587 * g + 0.114 * b


def on_color(base: str, candidates: list[str]) -> tuple[str, int]:
    base_l = luma(base)
    best = max(candidates, key=lambda c: abs(luma(c) - base_l))
    return best, round(abs(luma(best) - base_l))


def mix(a: str, b: str, t: float) -> str:
    """Linear mix of two #rrggbb colors; t=0 → a, t=1 → b."""
    ar, ag, ab = (int(a[i : i + 2], 16) for i in (1, 3, 5))
    br, bg, bb = (int(b[i : i + 2], 16) for i in (1, 3, 5))
    r = round(ar + (br - ar) * t)
    g = round(ag + (bg - ag) * t)
    bl = round(ab + (bb - ab) * t)
    return f"#{r:02x}{g:02x}{bl:02x}"


def load_theme(theme_dir: Path):
    toml_path = theme_dir / "colors.toml"
    try:
        with open(toml_path, "rb") as f:
            data = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        return None, f"cannot read {toml_path}: {e}"

    def col(*keys):
        for k in keys:
            v = parse_hex(data.get(k))
            if v:
                return v
        return None

    background = col("background")
    foreground = col("foreground")
    accent = col("accent", "blue")
    if not (background and foreground and accent):
        return None, f"{toml_path} lacks background/foreground/accent"

    return {
        "mode": "light" if data.get("mode") == "light" else "dark",
        "background": background,
        "foreground": foreground,
        "accent": accent,
        "dark_background": col("dark_background", "background"),
        "darker_background": col("darker_background", "dark_background", "background"),
        "lighter_background": col("lighter_background", "background"),
        "muted": col("muted", "dark_foreground", "foreground"),
        "selection": col("selection", "lighter_background", "background"),
        "red": col("red", "bright_red") or accent,
        "green": col("green", "bright_green") or accent,
        "yellow": col("yellow", "bright_yellow") or accent,
        "magenta": col("magenta", "bright_magenta") or accent,
        "blue": col("blue", "bright_blue") or accent,
        "cyan": col("cyan", "bright_cyan") or accent,
        "orange": col("orange", "yellow") or accent,
        "bright_foreground": col("bright_foreground", "foreground"),
        "dark_foreground": col("dark_foreground", "muted", "foreground"),
    }, None


def build_palette(t):
    dark = t["mode"] == "dark"
    if dark:
        window_bg = t["background"]
        view_bg = t["dark_background"]
        headerbar_bg = t["darker_background"]
        surface_bg = t["lighter_background"]
        sidebar_bg = t["dark_background"]
    else:
        window_bg = t["dark_background"]
        view_bg = t["background"]
        headerbar_bg = t["darker_background"]
        surface_bg = t["background"]
        sidebar_bg = t["dark_background"]

    fg = t["foreground"]
    on_accent, separation = on_color(t["accent"], [t["background"], t["foreground"]])
    shade = "rgba(0, 0, 0, 0.36)" if dark else "rgba(0, 0, 6, 0.07)"
    border = mix(window_bg, fg, 0.18 if dark else 0.22)

    return {
        "mode": t["mode"],
        "window_bg": window_bg,
        "view_bg": view_bg,
        "headerbar_bg": headerbar_bg,
        "surface_bg": surface_bg,
        "sidebar_bg": sidebar_bg,
        "fg": fg,
        "accent": t["accent"],
        "on_accent": on_accent,
        "separation": separation,
        "muted": t["muted"],
        "selection": t["selection"],
        "shade": shade,
        "border": border,
        "red": t["red"],
        "green": t["green"],
        "yellow": t["yellow"],
        "orange": t["orange"],
        "on_red": on_color(t["red"], [t["background"], t["foreground"]])[0],
        "on_green": on_color(t["green"], [t["background"], t["foreground"]])[0],
        "on_yellow": on_color(t["yellow"], [t["background"], t["foreground"]])[0],
        "magenta": t["magenta"],
        "blue": t["blue"],
        "cyan": t["cyan"],
        "bright_fg": t["bright_foreground"],
        "dark_fg": t["dark_foreground"],
        "background": t["background"],
        "foreground": t["foreground"],
    }


